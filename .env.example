# --- Backend (.env) ---
# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-4-5

# Finnhub (https://finnhub.io)
FINNHUB_API_KEY=xxxxx

# Server
PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# Allowed origins (comma separated). Use the chrome-extension://<EXT_ID> origin in prod.
# In dev you can leave it empty (all origins allowed).
ALLOWED_ORIGINS=

# Rate limit (per authenticated user / IP fallback)
RATE_LIMIT_PER_HOUR=30
RATE_LIMIT_PER_DAY=200

# Cache TTL (seconds) for analyze responses
CACHE_TTL_SECONDS=300

# --- Supabase (auth + credit ledger) ---
# https://app.supabase.com  →  Project Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi... (NEVER ship this to clients)
SUPABASE_JWT_AUD=authenticated

# --- Polar.sh (credit purchases — Merchant of Record) ---
# https://polar.sh  →  Settings → API access tokens
POLAR_ACCESS_TOKEN=polar_oat_xxxxx
# https://polar.sh  →  Settings → Webhooks  (Standard Webhooks signing secret)
POLAR_WEBHOOK_SECRET=whsec_xxxxx
# "production" (live) or "sandbox" (sandbox.polar.sh, test cards)
POLAR_SERVER=production
# One-time product IDs created in the Polar dashboard
POLAR_PRODUCT_STARTER=prod_xxx_5usd
POLAR_PRODUCT_STANDARD=prod_xxx_10usd
POLAR_PRODUCT_PRO=prod_xxx_25usd
POLAR_PRODUCT_POWER=prod_xxx_50usd
POLAR_PRODUCT_UNLIMITED=prod_xxx_99usd

# Base URL used for Polar's success_url redirect (web landing or extension page).
PUBLIC_APP_URL=http://localhost:8787

# --- Extension build-time (packages/extension/.env) ---
# VITE_SUPABASE_URL=https://xxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
# VITE_BACKEND_URL=http://localhost:8787
# VITE_GOOGLE_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
