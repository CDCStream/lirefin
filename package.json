{
  "name": "lirefin",
  "private": true,
  "version": "0.1.0",
  "description": "Lirefin — AI Chrome extension that reads financial news and surfaces bullish / neutral / bearish signals for the assets in your portfolio, powered by Claude.",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "dev:backend": "pnpm --filter @fni/backend dev",
    "dev:extension": "pnpm --filter @fni/extension dev",
    "build:extension": "pnpm --filter @fni/extension build",
    "build:backend": "pnpm --filter @fni/backend build",
    "lint": "pnpm -r --filter \"./packages/*\" lint",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "test": "pnpm -r --filter \"./packages/*\" --if-present test",
    "icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "sharp": "^0.34.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
