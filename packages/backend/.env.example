# =============================================================================
# Lirefin backend (Railway / local) — environment template
# Copy to `.env` in this package root. Values here are illustrative only.
# =============================================================================

NODE_ENV=development
HOST=0.0.0.0
PORT=8787

# Public URL — must match HTTPS origin where this API is reached (billing success redirects, portals).
PUBLIC_APP_URL=http://localhost:8787

# Comma-separated CORS origins — include production extension chrome-extension://...
ALLOWED_ORIGINS=http://localhost:3000

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
FINNHUB_API_KEY=

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Billing — production after Dodo "Live payments active"
# -----------------------------------------------------------------------------
BILLING_PROVIDER=dodo

# test_mode → Dodo sandbox; live_mode → real charges after account approval.
DODO_ENV=test_mode

DODO_API_KEY=
# Webhook signing secret from Dodo Dashboard → Developer → Webhooks (Standard Webhooks spec).
DODO_WEBHOOK_KEY=

# Live product IDs (one per recurring plan; mirror packages/shared/src/credits.ts):
# Starter $5 · 350 | Standard $10 · 750 | Pro $25 · 2k | Power $50 · 4.5k | Unlimited $99 · 10k credits.
DODO_PRODUCT_STARTER=
DODO_PRODUCT_STANDARD=
DODO_PRODUCT_PRO=
DODO_PRODUCT_POWER=
DODO_PRODUCT_UNLIMITED=

# Webhook POST URL exposed publicly, e.g.:
# https://YOUR-RAILWAY-HOST.up.railway.app/api/billing/webhook/dodo
