# =============================================================================
# Lirefin extension — build-time environment variables
# =============================================================================
# Copy this file to `packages/extension/.env` and fill in the real values, then
# rebuild with:
#
#   pnpm --filter @fni/extension build
#
# After the build completes, reload the extension in `chrome://extensions`.
#
# Notes:
#   * Vite ONLY exposes variables prefixed with `VITE_` to client code.
#   * The anon key is safe to ship to the browser; the service-role key is NOT
#     and lives only in `packages/backend/.env`.
#   * `VITE_BACKEND_URL` should point at your running backend (Fastify). In
#     local dev that's usually http://localhost:8787; in production it's your
#     Railway / Fly.io / Render URL.
# =============================================================================

# Supabase project (https://app.supabase.com → Project Settings → API)
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Backend (Fastify) base URL — used by the extension to call /api/* endpoints
VITE_BACKEND_URL=http://localhost:8787

# Google OAuth client ID for "Sign in with Google" via chrome.identity
VITE_GOOGLE_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com

# Toggle the in-extension billing UI. While the payment provider integration is
# pending (post-Polar / pre-Dodo), set this to "false" to render a friendly
# "coming soon" placeholder instead of a broken checkout flow. Flip to "true"
# the day the new provider goes live in production.
VITE_ENABLE_BILLING=false
