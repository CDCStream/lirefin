# =============================================================================
# Lirefin landing — environment variables
# =============================================================================
# Copy to .env.local for local development.
# In Vercel: set these in Project Settings → Environment Variables.
# =============================================================================

# Public site URL (used for canonical, OG tags, sitemap, robots).
# Local: http://localhost:3000
# Production: https://lirefin.com (or your Vercel preview URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
