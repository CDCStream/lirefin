# =============================================================================
# Lirefin landing — environment variables
# =============================================================================
# Copy to .env.local for local development.
# In Vercel: set these in Project Settings → Environment Variables.
# =============================================================================

# Public site URL (used for canonical, OG tags, sitemap, robots).
# Local: http://localhost:3000
# Production: https://lirefin.com (or your Vercel preview URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console — HTML meta verification (optional). If unset, landing uses the
# default token in layout.tsx; set this when you regenerate verification in Search Console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 — Measurement ID (G-xxxxxxxxxx); defaults in src/lib/analytics.ts.
# GA loads site-wide with Consent Mode (denied until the user accepts in the banner).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Ahrefs Web Analytics — data-key override; defaults in src/lib/analytics.ts. Loads from root layout.
NEXT_PUBLIC_AHREFS_WEB_ANALYTICS_KEY=
